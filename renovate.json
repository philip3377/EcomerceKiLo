{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "labels": [
    "Checking EcommerceKiLo dependencies"
  ],
  "extends": [
    "config:recommended"
  ],
  "schedule": [
    "before 4am on monday"
  ],
  "timezone": "Asia/Yangon",
  "dependencyDashboard": true,
  "packageRules": [
    {
      "description": "Group patch and minor updates",
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "groupName": "Non-major dependency updates"
      "automerge": false,
    },
    {
      "description": "keep major updates separate for manual review",
      "matchUpdateTypes": [
        "major"
      ]
      "automerge": false,
    }
  ]
}
